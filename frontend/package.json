{
  "name": "getvnt-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:marketplace & npm run dev:workspace & npm run dev:admin & node gateway.js",
    "dev:marketplace": "npm --prefix apps/marketplace run dev",
    "dev:workspace": "npm --prefix apps/workspace run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "gateway": "node gateway.js",
    "build": "npm run build:marketplace && npm run build:workspace && npm run build:admin",
    "build:marketplace": "npm --prefix apps/marketplace run build",
    "build:workspace": "npm --prefix apps/workspace run build",
    "build:admin": "npm --prefix apps/admin run build"
  }
}
