# Stage 1: Build All Frontend Apps
FROM node:20-alpine AS build

WORKDIR /app

# Copy root package definitions
COPY package*.json ./
COPY frontend/package*.json ./frontend/
COPY frontend/apps/marketplace/package*.json ./frontend/apps/marketplace/
COPY frontend/apps/workspace/package*.json ./frontend/apps/workspace/
COPY frontend/apps/admin/package*.json ./frontend/apps/admin/
COPY frontend/shared/package*.json ./frontend/shared/

# Install dependencies
RUN npm --prefix frontend install

# Copy source code
COPY frontend ./frontend

# Build production bundles
RUN npm --prefix frontend run build:marketplace
RUN npm --prefix frontend run build:workspace
RUN npm --prefix frontend run build:admin

# Stage 2: Serve via Nginx
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts to Nginx html directory
COPY --from=build /app/frontend/apps/marketplace/dist /usr/share/nginx/html/marketplace
COPY --from=build /app/frontend/apps/workspace/dist /usr/share/nginx/html/workspace
COPY --from=build /app/frontend/apps/admin/dist /usr/share/nginx/html/admin

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
