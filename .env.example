# NOTE: Real secret values live in the deploy platform's secrets manager. Never commit real credentials.

# ==============================================================================
# GETVNT PRODUCTION & STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAINS & PLATFORM URLS
# ------------------------------------------------------------------------------
PRIMARY_DOMAIN=getvnt.com
WORKSPACE_DOMAIN=app.getvnt.com
ADMIN_DOMAIN=admin.getvnt.com
API_DOMAIN=api.getvnt.com

APP_URL=https://getvnt.com
FRONTEND_URL=https://getvnt.com
WORKSPACE_URL=https://app.getvnt.com
ADMIN_URL=https://admin.getvnt.com
API_URL=https://api.getvnt.com

# ------------------------------------------------------------------------------
# 2. CORS & SANCTUM SECURITY
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=getvnt.com,www.getvnt.com,app.getvnt.com,admin.getvnt.com,api.getvnt.com
SESSION_DOMAIN=.getvnt.com
CORS_ALLOWED_ORIGINS=https://getvnt.com,https://www.getvnt.com,https://app.getvnt.com,https://admin.getvnt.com,https://api.getvnt.com

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHE SERVICES
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eventos
DB_USERNAME=eventos_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_PLACEHOLDER
MYSQL_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD_PLACEHOLDER
APP_KEY=base64:YOUR_APP_KEY_PLACEHOLDER
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_PLACEHOLDER

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION PROVIDERS (MANAGED VIA SUPER ADMIN & DOKPLOY)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.getvnt.com/api/v1/auth/google/callback
